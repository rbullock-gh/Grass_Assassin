# ---- Core ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://grass:grass@localhost:5432/grassassassin

# ---- Redis / queues ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=replace-me-min-32-chars-development-only
JWT_REFRESH_SECRET=replace-me-min-32-chars-development-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Admin dashboard ----
# REQUIRED in production: the dashboard can change platform fees and resolve
# disputes, and it refuses to start without this rather than defaulting to open.
# Leave it unset locally to run unauthenticated (a banner on the page says so).
# This signs session cookies only; administrators sign in with their own user
# accounts, so every fee change and dispute resolution names a real person.
# Create the first one with:
#   pnpm --filter @grassassassin/api admin:create -- --email you@example.com --password '...'
ADMIN_SESSION_SECRET=replace-me-min-32-chars-development-only
# Where the dashboard reaches the API, and the token proving a call is from the
# dashboard. Required to resolve disputes: refunds are issued by the API, which
# is the only process that should hold the payment provider's credentials.
# The API also requires the acting administrator's id and checks the role
# itself, so this token alone cannot act as an arbitrary user.
API_BASE_URL=http://localhost:4000
ADMIN_SERVICE_TOKEN=replace-me-min-32-chars-development-only

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# ---- Maps ----
MAPBOX_ACCESS_TOKEN=pk.xxx
GOOGLE_MAPS_API_KEY=AIza_xxx

# ---- Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grassassassin-photos
R2_PUBLIC_BASE_URL=

# ---- Third party ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
CHECKR_API_KEY=
RESEND_API_KEY=
SENTRY_DSN=

# ---- Push ----
# Notifications are RECORDED but not DELIVERED unless this is exactly "true".
# Deliberately separate from the access token below: a staging environment
# restored from production data must not push to real customers, and "we happen
# to have an Expo token" is not the same decision as "this process should send".
PUSH_ENABLED=false
# Required once push security is enabled on the Expo project. Sending without it
# works until somebody turns that on, and then every push fails at once.
EXPO_ACCESS_TOKEN=
