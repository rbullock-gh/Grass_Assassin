{
  "name": "grassassassin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @grassassassin/api db:migrate",
    "db:seed": "pnpm --filter @grassassassin/api db:seed",
    "dev:api": "pnpm --filter @grassassassin/api dev"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^22.10.2",
    "jose": "5.10.0",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7"
    }
  }
}